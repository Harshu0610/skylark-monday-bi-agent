# Monday.com (READ-ONLY personal API token)
MONDAY_API_TOKEN=your_monday_token_here
MONDAY_DEALS_BOARD_NAME=Deals
MONDAY_WORK_ORDERS_BOARD_NAME=Work Orders
# Optional: pin board IDs explicitly (otherwise resolved by name)
# MONDAY_DEALS_BOARD_ID=
# MONDAY_WORK_ORDERS_BOARD_ID=

# LLM provider: groq | anthropic | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# App
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
FISCAL_YEAR_START_MONTH=4
